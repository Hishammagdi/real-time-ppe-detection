# Path to the fine-tuned YOLOv8 weights (from the model step)
MODEL_WEIGHTS_PATH=../model/weights/ppe_best.pt

# Default confidence threshold if the frontend doesn't send one
DEFAULT_CONF_THRESHOLD=0.4

# Upload limits
MAX_UPLOAD_SIZE_MB=200

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated origins, or * for all (dev only)
ALLOWED_ORIGINS=*
