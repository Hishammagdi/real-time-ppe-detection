# Roboflow (used to download the labeled dataset)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace_slug
ROBOFLOW_PROJECT=your_project_slug
ROBOFLOW_VERSION=1

# Training config
BASE_MODEL=yolov8n.pt
EPOCHS=100
IMG_SIZE=640
BATCH_SIZE=16

# Output
RUN_NAME=custom_detector
